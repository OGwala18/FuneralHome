# =============================================================================
# Staff portal settings. Copy to `.env`.
#
# Everything here is PUBLIC: Vite compiles VITE_* variables into the browser
# bundle. A publishable key identifies the Supabase project, it does not grant
# access. Access is decided by the API's STAFF_EMAILS allowlist.
#
# NEVER put a service-role key or any secret in this file.
# =============================================================================

VITE_SUPABASE_URL=https://sksisuttffzpctdxtjzt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_L5Oikcry6LPHo4FTWqbCNA_OslGaLmB

# The API that serves enquiry data. Production: https://api.induduzo.co.za
VITE_API_BASE_URL=http://localhost:8000

# --- Error tracking (Sentry) ------------------------------------------------
# Blank = off. This value ships in the browser bundle, which is expected: a DSN
# only permits writing events, it grants no read access to your Sentry data.
#
# Session Replay is deliberately DISABLED in code: it would record an applicant
# typing their ID number into the form.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
VITE_RELEASE=

