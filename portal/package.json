  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.5"
  }
