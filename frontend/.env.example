

# --- Error tracking (Sentry) ------------------------------------------------
# Blank = off. This value ships in the browser bundle, which is expected: a DSN
# only permits writing events, it grants no read access to your Sentry data.
#
# Session Replay is deliberately DISABLED in code: it would record an applicant
# typing their ID number into the form.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
VITE_RELEASE=


# --- Google Maps embed ------------------------------------------------------
# Optional. Blank uses the keyless Google Maps iframe, which needs no account.
# Set it to use the Maps Embed API instead. This value ships in the browser
# bundle, so restrict the key to the Maps Embed API and to the site's referrers
# (induduzo.co.za) in the Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=
