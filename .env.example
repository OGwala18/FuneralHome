# =============================================================================
# Local infrastructure settings. Copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER put a production credential in this file — this
# example is committed, and anything written here is public.
#
# The API has its own settings in backend/.env (see backend/.env.example).
# =============================================================================

# --- Local Postgres (docker compose) ----------------------------------------
POSTGRES_USER=induduzo
POSTGRES_PASSWORD=induduzo_local_dev
POSTGRES_DB=induduzo

# Host port. 5433 rather than 5432 because this machine already runs another
# Postgres. Inside the compose network the port is always 5432.
POSTGRES_PORT=5433

# Password for the restricted role the API connects as (induduzo_api).
# Separate from the owner password on purpose: the API must NOT be an owner,
# because an owner bypasses row-level security.
API_DB_PASSWORD=induduzo_api_local_dev

# --- pgAdmin (local browsing only) ------------------------------------------
# The email is only a login identity; pgAdmin rejects reserved TLDs like .local,
# so it has to look routable. Nothing is ever sent to it.
PGADMIN_EMAIL=admin@induduzo.co.za
PGADMIN_PASSWORD=induduzo_local_dev
