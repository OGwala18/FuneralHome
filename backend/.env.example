# Local development. Copy to .env and adjust.
# The DB runs on 5433 because this machine already has a Postgres on 5432.
DATABASE_URL=postgresql://induduzo:induduzo_local_dev@localhost:5433/induduzo
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Twilio WhatsApp. Leave blank in dev: confirmations are logged, not sent,
# and registration still succeeds.
# Sandbox sender is +14155238886 (Console > Messaging > Try it out > WhatsApp).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Required for production: business-initiated WhatsApp needs an approved
# Content template. Without it, sends only work in the sandbox.
TWILIO_CONTENT_SID=
