# =============================================================================
# API settings. Copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER put a production credential in this file — this
# example is committed, and anything written here is public.
# =============================================================================

# --- Database ---------------------------------------------------------------
# 5433, not 5432: this machine already runs another Postgres.
# Connects as the RESTRICTED role, not the owner. An owner bypasses
# row-level security, which would make the policies in 0004 meaningless.
DATABASE_URL=postgresql://induduzo_api:induduzo_api_local_dev@localhost:5433/induduzo

ENVIRONMENT=development

# Browsers allowed to call this API. Must be exact origins, never "*", because
# a wildcard would let any site on the internet post enquiries.
# Public site (8080) and staff portal (8090). Exact origins, never "*":
# a wildcard would let any site on the internet call this API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8090,http://127.0.0.1:8090

# --- Admin notification email -----------------------------------------------
# Every stage-1 enquiry is emailed here the moment it is captured, whether or
# not the person completes the full application.
#
# Leave SMTP_HOST blank in dev: the message is logged instead of sent and the
# enquiry still succeeds. A mail outage must never cost a lead.
#
# For domains.co.za "Email Only" hosting the values look like:
#   SMTP_HOST=mail.induduzo.co.za
#   SMTP_PORT=587            (STARTTLS)  or  465 (implicit TLS)
# See docs/email-setup-plan.md — the mailbox has to exist first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Set to 1 only if using implicit TLS on a non-465 port. Port 465 implies it.
SMTP_USE_SSL=
SMTP_TIMEOUT=15

MAIL_FROM=no-reply@induduzo.co.za
MAIL_TO=admin@induduzo.co.za

# --- Twilio WhatsApp --------------------------------------------------------
# Confirmation sent to the applicant after stage 2. Blank in dev = logged only.
# Sandbox sender is +14155238886 (Console > Messaging > Try it out > WhatsApp).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Required in production: a business-initiated WhatsApp needs an approved
# Content template. Without it, sends only work in the Twilio sandbox.
TWILIO_CONTENT_SID=

# --- Staff portal -----------------------------------------------------------
SUPABASE_URL=https://sksisuttffzpctdxtjzt.supabase.co

# Bootstrap only. If the staff table is EMPTY, these addresses become owners on
# first sign-in, so a fresh deployment is not locked out. Once any staff row
# exists this list is ignored and the database is the sole authority.
STAFF_EMAILS=admin@induduzo.co.za

# HIGHLY SENSITIVE and OPTIONAL. Lets the API email staff invitations.
# It can create accounts and read every user, so it stays server-side only and
# must never appear in a VITE_ variable. Without it, invitations are created by
# hand in the Supabase dashboard and everything else still works.
SUPABASE_SERVICE_ROLE_KEY=

# --- Error tracking (Sentry) ------------------------------------------------
# Blank = off, and the app runs normally. A DSN is a write-only ingest endpoint
# rather than a secret like an API key, but it still belongs in the environment.
#
# Personal data is stripped before anything is sent: request bodies are dropped,
# stack-frame locals are disabled, and ID/mobile/email patterns are redacted.
# See app/observability.py.
SENTRY_DSN=

# Fraction of requests traced for performance. Billed per transaction.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Tags each event with the deployed commit so an error maps to exact code.
# Railway sets RAILWAY_GIT_COMMIT_SHA automatically.
RELEASE=

