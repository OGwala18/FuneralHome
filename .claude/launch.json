{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "induduzo-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--env-file", "backend/.env", "--host", "127.0.0.1", "--port", "8000", "--reload", "--reload-dir", "backend/app"],
      "port": 8000,
      "url": "http://127.0.0.1:8000",
      "autoPort": false
    },
    {
      "name": "induduzo-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "induduzo-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "portal"],
      "port": 8090,
      "autoPort": false
    }
  ]
}
